        "platform": "Javascript/Node.js",
        "icon": "blink.png",
        "enabled": true,
        "extIcon": "https://raw.githubusercontent.com/Sven-83/ioBroker.blink/main/admin/blink.png",
        "readme": "https://github.com/Sven-83/ioBroker.blink/blob/main/README.md",
        "loglevel": "info",
        "tier": 3,
        "mode": "daemon",
        "type": "alarm",
        "compact": true,
        "connectionType": "cloud",
        "dataSource": "poll",
        "messagebox": true,
        "adminUI": {
            "config": "json"
        },
        "dependencies": [
            {
                "js-controller": ">=6.0.11"
            }
        ],
        "globalDependencies": [
            {
                "admin": ">=7.6.20"
            }
        ]

{
  "name": "iobroker.blink",
  "version": "0.1.0",
  "description": "Blink cameras: arm/disarm with readback, snapshots and live view",
  "author": {
    "name": "Sven-83",
    "email": "276080681+Sven-83@users.noreply.github.com"
  },
  "contributors": [],
  "homepage": "https://github.com/Sven-83/ioBroker.blink",
  "license": "MIT",
  "keywords": [
    "blink",
    "camera",
    "security",
    "alarm",
    "snapshot",
    "ioBroker"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Sven-83/ioBroker.blink.git"
  },
  "engines": {
    "node": ">= 22"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.3"
  },
  "devDependencies": {
    "@iobroker/adapter-dev": "^1.5.0",
    "@iobroker/dev-server": "^0.8.0",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/testing": "^6.3.1",
    "@tsconfig/node22": "^22.0.6",
    "@types/iobroker": "npm:@iobroker/types@^7.2.5",
    "@types/node": "^22.20.5",
    "c8": "^12.0.0",
    "rimraf": "^6.1.3",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "typescript": "~7.0.2"
  },
  "main": "build/main.js",
  "files": [
    "admin{,/!(src)/**}/!(tsconfig|tsconfig.*|.eslintrc).{json,json5}",
    "admin{,/!(src)/**}/*.{html,css,png,svg,jpg,js}",
    "build/",
    "io-package.json",
    "LICENSE"
  ],
  "scripts": {
    "prebuild": "rimraf build",
    "build": "build-adapter ts",
    "watch": "build-adapter ts --watch",
    "test:ts": "mocha --config test/mocharc.custom.json \"src/**/*.test.ts\"",
    "coverage": "c8 npm run test:ts",
    "test:package": "mocha test/package --exit",
    "test:integration": "mocha test/integration --exit",
    "test": "npm run test:ts && npm run test:package",
    "check": "tsc --noEmit",
    "lint": "eslint -c eslint.config.mjs .",
    "translate": "translate-adapter",
    "dev-server": "dev-server"
  },
  "bugs": {
    "url": "https://github.com/Sven-83/ioBroker.blink/issues"
  },
  "readmeFilename": "README.md"
}

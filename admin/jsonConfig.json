{
    "i18n": true,
    "type": "panel",
    "items": {
        "_headerAccount": {
            "type": "header",
            "text": "Blink account",
            "size": 2
        },
        "email": {
            "type": "text",
            "label": "E-mail address",
            "validator": "/^[^ @]+@[^ @]+[.][^ @]+$/.test((data.email || '').trim())",
            "validatorErrorText": "Please enter the e-mail address",
            "validatorNoSaveOnError": true,
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        },
        "password": {
            "type": "password",
            "label": "Password",
            "validator": "!!data.password",
            "validatorErrorText": "Please enter the password",
            "validatorNoSaveOnError": true,
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        },
        "_header2fa": {
            "type": "header",
            "text": "Two-factor authentication",
            "size": 2,
            "newLine": true
        },
        "pin": {
            "type": "text",
            "label": "2FA code",
            "help": "Only needed when Blink sends a code by SMS or e-mail. Enter it here and save; it is used once and then deleted.",
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        },
        "_headerPolling": {
            "type": "header",
            "text": "Polling",
            "size": 2,
            "newLine": true
        },
        "pollInterval": {
            "type": "number",
            "label": "Polling interval",
            "help": "Seconds, minimum 30",
            "min": 30,
            "max": 3600,
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        }
    }
}

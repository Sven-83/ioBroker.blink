{
    "i18n": true,
    "type": "panel",
    "items": {
        "_headerAccount": {
            "type": "header",
            "text": "Blink account",
            "size": 2
        },
        "email": {
            "type": "text",
            "label": "E-mail address",
            "validator": "/^[^ @]+@[^ @]+[.][^ @]+$/.test((data.email || '').trim())",
            "validatorErrorText": "Please enter the e-mail address",
            "validatorNoSaveOnError": true,
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        },
        "password": {
            "type": "password",
            "label": "Password",
            "validator": "!!data.password",
            "validatorErrorText": "Please enter the password",
            "validatorNoSaveOnError": true,
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        },
        "_header2fa": {
            "type": "header",
            "text": "Two-factor authentication",
            "size": 2,
            "newLine": true
        },
        "pin": {
            "type": "text",
            "label": "2FA code",
            "help": "Only needed when Blink sends a code by SMS or e-mail. Enter it here and save; it is used once and then deleted.",
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        },
        "_headerPolling": {
            "type": "header",
            "text": "Polling",
            "size": 2,
            "newLine": true
        },
        "pollInterval": {
            "type": "number",
            "label": "Polling interval",
            "help": "Seconds, minimum 30",
            "min": 30,
            "max": 3600,
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        },
        "_headerImages": {
            "type": "header",
            "text": "Images",
            "size": 2,
            "newLine": true
        },
        "imageRetentionHours": {
            "type": "number",
            "label": "Keep images for",
            "help": "Hours, 1 to 720. Images of the cameras are personal data and are deleted after this time.",
            "min": 1,
            "max": 720,
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        },
        "_headerLive": {
            "type": "header",
            "text": "Live image",
            "size": 2,
            "newLine": true
        },
        "liveEnabled": {
            "type": "checkbox",
            "label": "Allow live image",
            "help": "Needs ffmpeg. A live image keeps a battery camera awake.",
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        },
        "liveBind": {
            "type": "text",
            "label": "Address of the live image",
            "help": "127.0.0.1 is this computer only. Enter the address of this computer for displays in your network.",
            "hidden": "!data.liveEnabled",
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        },
        "livePort": {
            "type": "number",
            "label": "Port of the live image",
            "min": 1024,
            "max": 65535,
            "hidden": "!data.liveEnabled",
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        },
        "liveMaxSeconds": {
            "type": "number",
            "label": "Time limit of a live image",
            "help": "Seconds, 30 to 600",
            "min": 30,
            "max": 600,
            "hidden": "!data.liveEnabled",
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        },
        "ffmpegPath": {
            "type": "text",
            "label": "Path of ffmpeg",
            "help": "Empty: ffmpeg is searched in the usual places. Otherwise the full path of the program.",
            "hidden": "!data.liveEnabled",
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        },
        "_headerBattery": {
            "type": "header",
            "text": "Battery warning",
            "size": 2,
            "newLine": true
        },
        "batteryWarning": {
            "type": "checkbox",
            "label": "Warn when a battery is low",
            "help": "Sends one message per camera when Blink reports a low battery. Text only, no images.",
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        },
        "notifyInstance": {
            "type": "instance",
            "adapter": "telegram",
            "label": "Telegram instance",
            "hidden": "!data.batteryWarning",
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        },
        "notifyUsers": {
            "type": "text",
            "label": "Receivers",
            "help": "Telegram user names, separated by commas. Empty: all users of the instance.",
            "hidden": "!data.batteryWarning",
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        },
        "_batteryTest": {
            "type": "sendTo",
            "command": "batteryTest",
            "label": "Send a test message",
            "jsonData": "{\"instance\":\"${data.notifyInstance}\",\"users\":\"${data.notifyUsers}\"}",
            "showProcess": true,
            "hidden": "!data.batteryWarning",
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        }
    }
}
